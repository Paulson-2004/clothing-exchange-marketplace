# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/clothing-exchange

# Auth
JWT_SECRET=replace_with_a_long_random_string

# Frontend origin (for CORS + cookie settings)
CLIENT_URL=http://localhost:5173

# Cloudinary (image storage) - never expose these to the frontend
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Seed admin (used only by scripts/seedAdmin.js, never hardcoded)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
