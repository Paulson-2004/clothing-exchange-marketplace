{
  "name": "clothing-exchange-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Root development scripts for ReWear Clothing Exchange & Swap Marketplace",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
